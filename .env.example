# Browser requests use same-origin /api/v1; Next.js proxies on the server.
ECONOTES_API_ORIGIN=http://127.0.0.1:8000
# Optional direct API origin for deployments that prefer browser-to-API requests.
# NEXT_PUBLIC_API_BASE_URL=https://api.example.com/api/v1
# Optional: defaults to api/econotes.db
# ECONOTES_DB=/absolute/path/to/econotes.db
