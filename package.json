{
  "name": "econotes",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "dev:all": "python3 scripts/dev.py",
    "api": "python3 -m uvicorn api.app.main:app --host 127.0.0.1 --port 8000 --reload",
    "build": "next build",
    "export:static-data": "python3 scripts/export_static_data.py",
    "build:static": "NEXT_OUTPUT_MODE=export NEXT_PUBLIC_STATIC_DATA=1 next build",
    "prepare:static": "npm run export:static-data && npm run build:static",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fontsource/vazirmatn": "^5.2.7",
    "echarts": "^6.1.0",
    "echarts-for-react": "^3.0.5",
    "lucide-react": "^0.468.0",
    "next": "16.3.7",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "16.3.7",
    "typescript": "^5.9.0"
  }
}
